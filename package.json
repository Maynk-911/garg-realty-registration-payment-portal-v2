{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:mock-sheets": "tsx --import ./tests/mockGoogleSheets.mjs server.ts",
    "test:flow": "tsx tests/flow_test.ts",
    "test:dholera": "tsx tests/dholera_flow_test.ts",
    "test:db": "tsx tests/database_test.ts",
    "sheets:check": "tsx scripts/check_google_sheets.ts",
    "db:check": "tsx scripts/check_database.ts",
    "db:cleanup-test": "tsx scripts/cleanup_test_records.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --define:__SERVER_BUNDLE__=true --outfile=build/server.js",
    "start": "node build/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test:cp": "tsx tests/cp_flow_test.ts",
    "test:cp-ratelimit": "tsx tests/cp_rate_limit_test.ts",
    "test:body-parsing": "tsx tests/body_parsing_test.ts",
    "test:cp-track": "tsx tests/cp_track_test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "nodemailer": "10.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "typescript": "^7.0.2"
  }
}
