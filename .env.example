# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Payment Gateway (Razorpay)
# Set PAYMENT_ENV to "test" for sandbox/demo, "production" for live transactions
PAYMENT_ENV="test"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Company & Subdomain Configuration
COMPANY_NAME="Garg Realty Group"
COMPANY_LEGAL_ENTITY="Garg Residency Private Limited"
APP_SUBDOMAIN="apply.yourdomain.com"
ADMIN_EMAIL="admin@gargrealty.com"

# CRM & Lead Capture Webhook / API
CRM_API_URL="https://crm.example.com/api/v1/leads"
CRM_API_KEY="crm_api_key_placeholder"

# Notification Services (Email & WhatsApp)
EMAIL_SERVICE_KEY="email_service_key_placeholder"
WHATSAPP_API_KEY="whatsapp_api_key_placeholder"

# Admin Authentication Secret
ADMIN_JWT_SECRET="garg_realty_admin_secure_key_2026"

# Firebase Firestore (Optional - fallback to local atomic persistence if omitted)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

