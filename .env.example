# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where the portal is hosted (must be a real address, e.g. https://apply.yourdomain.com).
APP_URL="https://apply.yourdomain.com"

# Production (Hostinger): set NODE_ENV="production" so the built app in dist/ is served and test tools stay disabled.
# Leave it unset for local development. PORT is normally provided by the host (defaults to 3000).
# NODE_ENV="production"

# Payment Gateway (Razorpay)
# Set PAYMENT_ENV to "test" for sandbox/demo, "production" for live transactions
PAYMENT_ENV="test"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Company & Subdomain Configuration
COMPANY_NAME="Garg Realty Group"
COMPANY_LEGAL_ENTITY="Garg Residency Private Limited"
APP_SUBDOMAIN="apply.yourdomain.com"
ADMIN_EMAIL="admin@example.com"

# CRM & Lead Capture Webhook / API
CRM_API_URL="https://crm.example.com/api/v1/leads"
CRM_API_KEY="crm_api_key_placeholder"

# Notification Services (Email & WhatsApp)
EMAIL_SERVICE_KEY="email_service_key_placeholder"
WHATSAPP_API_KEY="whatsapp_api_key_placeholder"

# Admin setup: set ADMIN_EMAIL above and a unique password (at least 16 characters).
# On restart, ADMIN_PASSWORD securely provisions/updates the admin account in the existing database.
ADMIN_PASSWORD=""
# Generate a unique signing secret (at least 32 characters). Admin access fails closed without it.
ADMIN_JWT_SECRET=""

# Local testing only: accept simulated (unverified) gateway confirmations. Never enable in production.
ALLOW_SIMULATED_PAYMENTS="false"

# Google Sheets booking/payment records (SERVER-SIDE ONLY - never prefix with VITE_, never commit real values)
# Existing private spreadsheet. The app never creates a spreadsheet and never changes its sharing.
GOOGLE_SHEETS_SPREADSHEET_ID="1uw77HSMk5smqdBipFmDlj3BikxqeB4T6zXZh_7Lex8I"
# Tab (sheet) inside that spreadsheet that receives the booking rows
GOOGLE_SHEET_NAME="Sheet1"
# Credentials of a service account that has Editor access to the spreadsheet (Share > add its client_email).
# EASIEST: path to the JSON key file downloaded from Google Cloud. Keep the file OUTSIDE this project folder.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""
# ALTERNATIVE (e.g. on hosting without files): leave the line above empty and fill these two from the JSON key.
# Paste "private_key" on one line, keeping the \n sequences.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# After editing, run:  npm run sheets:check

# MySQL / MariaDB database (Hostinger) — REQUIRED in production.
# Copy the values from hPanel > Databases > Management. Never commit real values.
# DB_HOST: the MySQL host shown by Hostinger (do not guess "localhost").
DB_HOST=""
DB_PORT="3306"
# DB_NAME / DB_USER include your account prefix, e.g. u123456789_garg_portal
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
# Optional: connection pool size (default 5; keep low on shared hosting) and TLS ("true" if your host requires it)
# DB_POOL_SIZE="5"
# DB_SSL="false"

# Channel Partner (CP) / Broker onboarding (/cp-registration). All optional.
# E-mail (SMTP) for acknowledgements, approvals, rejections and information requests. Without these, nothing is sent and
# the admin panel shows every notification as "not sent - e-mail not configured". Hostinger e-mail: smtp.hostinger.com, port 465.
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Garg Realty Group <partners@yourdomain.com>"
# Inbox for "new application" alerts (defaults to ADMIN_EMAIL); contact details printed in applicant e-mails
# CP_NOTIFY_EMAIL=""
# CP_CONTACT_EMAIL=""
# CP_CONTACT_PHONE=""
# Documents applicants MUST upload (comma-separated; default none). Keys: PHOTO, PAN_CARD, GST_CERTIFICATE,
# RERA_CERTIFICATE, COMPANY_REGISTRATION, ADDRESS_PROOF, OTHER
# CP_REQUIRED_DOCUMENTS=""
# Upload limits in MB (defaults 2 per file, 10 per application) and applications per visitor per hour (default 10)
# CP_MAX_FILE_MB="2"
# CP_MAX_TOTAL_MB="10"
# CP_SUBMISSIONS_PER_HOUR="10"
# Accept applicants outside India (default false: country fixed to India, PAN required)
# CP_ALLOW_INTERNATIONAL="false"
# Track CP Application (/track-cp-application): requests per connection per 15 minutes (defaults 30 and 10)
# CP_TRACK_LOOKUPS_PER_15MIN="30"
# CP_TRACK_CERTIFICATE_TRIES_PER_15MIN="10"

# Local development only: when DB_HOST is empty, the app uses data/db.json instead (refused in production).
# Folder for the booking database (db.json). Defaults to ./data inside the project.
# In production use an absolute folder OUTSIDE the deployed code so redeploys never touch bookings,
# e.g. DATA_DIR="/home/<your-hostinger-user>/garg-realty-data"
# DATA_DIR="data"

# Firebase Firestore (Optional - fallback to local atomic persistence if omitted)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
